-- CodecWire — Low-level JSON v1 shape, type and canonical-Int helpers. Prefer CodecJson
-- for domain values; these helpers alone do not validate accounts, balance histories,
-- bound payload size or establish authenticity.
--
-- Usage and tested examples: docs/guide.md and test/docs_quickstart_test.march.

mod CodecWire do
  doc """
  Parse JSON text s to JsonValue; malformed JSON returns InvalidEncoding. Does not enforce
  any finance schema, version or size budget.
  """
  fn parse(s : String) : Result(Json.JsonValue, CodecError.Error) do Result.map_err(Json.parse(s), fn _ -> CodecError.InvalidEncoding) end
  doc """
  Check j against an exact expected field-name list: same count, each required name
  present, no duplicate keys. Return InvalidEncoding on mismatch. Intended for nonempty
  schema field lists; not a standalone type proof for an empty expected list. Does not
  check field value types.
  """
  fn object(j : Json.JsonValue, fields : List(String)) : Result(Unit, CodecError.Error) do
    let keys = match j do
      Json.Object(pairs) -> List.map(pairs, fn pair -> let (k, _) = pair k)
      _ -> Nil
    end
    if List.length(keys) == List.length(fields) && List.length(List.dedup(keys)) == List.length(keys) &&
      List.all(fields, fn key -> List.any(keys, fn k -> key == k)) do Ok(())
    else Err(CodecError.InvalidEncoding) end
  end
  doc """
  Return j's field named key or InvalidEncoding if missing/not accessible as an object
  field. Does not check other keys, duplicates or value type; use object first for schema
  validation.
  """
  fn field(j : Json.JsonValue, key : String) : Result(Json.JsonValue, CodecError.Error) do
    match Json.get(j, key) do
      Some(v) -> Ok(v)
      None -> Err(CodecError.InvalidEncoding)
    end
  end
  doc """
  Extract String from Json.Str; all other value kinds return InvalidEncoding. Empty text
  is permitted here; domain constructors enforce content rules.
  """
  fn string(j : Json.JsonValue) : Result(String, CodecError.Error) do
    match j do
      Json.Str(s) -> Ok(s)
      _ -> Err(CodecError.InvalidEncoding)
    end
  end
  doc """
  Return named field key as String by composing field and string. Missing or non-string
  field returns InvalidEncoding; no trimming or coercion occurs.
  """
  fn text(j : Json.JsonValue, key : String) : Result(String, CodecError.Error) do
    let? v = field(j, key)
    string(v)
  end
  doc """
  Map Json.Null to None and Json.Str(s) to Some(s); other kinds return InvalidEncoding.
  Empty string is preserved here, not treated as None; domain metadata may reject it.
  """
  fn optional(j : Json.JsonValue) : Result(Option(String), CodecError.Error) do
    match j do
      Json.Null -> Ok(None)
      Json.Str(s) -> Ok(Some(s))
      _ -> Err(CodecError.InvalidEncoding)
    end
  end
  doc """
  Encode None as Json.Null and Some(s) as Json.Str(s). Infallible; preserves
  empty/whitespace strings without domain validation.
  """
  fn option_value(value : Option(String)) : Json.JsonValue do
    match value do
      None -> Json.Null
      Some(s) -> Json.Str(s)
    end
  end
  doc """
  Extract an array's ordered JsonValue list; non-array input returns InvalidEncoding. Does
  not validate elements or bound length.
  """
  fn array(j : Json.JsonValue) : Result(List(Json.JsonValue), CodecError.Error) do
    match j do
      Json.Array(xs) -> Ok(xs)
      _ -> Err(CodecError.InvalidEncoding)
    end
  end
  doc """
  Parse s as machine Int only when rendering it back gives identical text. Reject
  overflow, plus signs, leading zeros, whitespace and negative zero with InvalidInteger.
  Arbitrary-size amount atoms are handled by core, not this helper.
  """
  fn integer(s : String) : Result(Int, CodecError.Error) do
    match string_to_int(s) do
      Some(n) -> if int_to_string(n) == s do Ok(n) else Err(CodecError.InvalidInteger) end
      None -> Err(CodecError.InvalidInteger)
    end
  end
  doc """
  Require string-valued version field equal to "1". Missing/non-string field returns
  InvalidEncoding; another string version returns UnsupportedVersion. Does not check other
  schema fields.
  """
  fn version(j : Json.JsonValue) : Result(Unit, CodecError.Error) do
    let? v = text(j, "version")
    if v == "1" do Ok(()) else Err(CodecError.UnsupportedVersion) end
  end
end
